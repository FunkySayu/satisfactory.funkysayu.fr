{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom", "dom.iterable", "webworker.importscripts"],
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
